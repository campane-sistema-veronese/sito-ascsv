---
import ThemeToggle from './ThemeToggle.astro'

interface Props {
  items?: { label: string; href: string }[]
  logoAlt?: string
}

const { items = [], logoAlt = 'ASCSV logo' } = Astro.props
---

<header
  class="sticky top-0 z-50 bg-white/90 dark:bg-stone-900/90 backdrop-blur-sm shadow-sm dark:shadow-black/30"
  role="banner"
>
  <div class="max-w-6xl mx-auto p-4 flex items-center justify-between">
    <a href="/" class="flex items-center gap-3">
      <img src="/images/ascsv_back.png" alt={logoAlt} class="h-12 block dark:hidden" />
      <img src="/images/ascsv_white.png" alt={logoAlt} class="h-12 hidden dark:block" />
    </a>

    <!-- Desktop navigation -->
    <nav aria-label="Main navigation" class="hidden md:flex items-center gap-6">
      {
        items.map((item) => (
          <a
            href={item.href}
            class="text-sm text-stone-800 dark:text-stone-100 hover:underline font-medium hover:text-primary-500"
          >
            {item.label}
          </a>
        ))
      }
      <ThemeToggle id="desktop-theme-toggle" />
    </nav>

    <!-- Mobile navigation button -->
    <div class="md:hidden">
      <button
        id="mobile-menu-button"
        aria-controls="mobile-menu"
        aria-expanded="false"
        class="px-3 py-2 rounded-md bg-gray-100 dark:bg-stone-800 text-stone-800 dark:text-stone-100 flex items-center"
        aria-label="Apri menu"
      >
        <span class="material-symbols-outlined">menu</span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile drawer (moved outside header so overlay covers viewport) -->
<div id="mobile-menu" class="fixed inset-0 z-9999 hidden" aria-hidden="true">
  <div
    class="absolute inset-0 bg-black/40 opacity-0 transition-opacity duration-200 pointer-events-none"
    data-menu-overlay
  >
  </div>

  <aside
    class="absolute flex flex-col top-0 right-0 h-full bg-white/90 dark:bg-stone-900 w-3/4 max-w-xs shadow-lg dark:shadow-black/40 transform translate-x-full transition-transform duration-200"
    role="dialog"
    aria-modal="true"
    aria-labelledby="mobile-menu-title"
  >
    <div class="flex items-center justify-between mb-4 mt-6 mx-6">
      <h2 id="mobile-menu-title" class="text-lg font-semibold text-stone-900 dark:text-stone-100">ASCSV</h2>
      <div class="flex items-center gap-4">
        <ThemeToggle id="mobile-theme-toggle" />
        <button
          id="mobile-menu-close"
          class="p-2 rounded-md flex items-center text-stone-900 dark:text-stone-100"
          aria-label="Chiudi menu"
        >
          <span class="material-symbols-outlined">close</span>
        </button>
      </div>
    </div>

    <hr class="text-gray-300 dark:text-stone-700 mb-4" />

    <nav class="flex flex-col gap-4 mx-6 flex-1" aria-label="Mobile navigation">
      {
        items.map((item) => (
          <a
            href={item.href}
            class="block text-base font-serif text-stone-900 dark:text-stone-100 hover:text-primary-500"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <hr class="text-gray-300 dark:text-stone-700 my-4" />

    <p class="text-xs font-serif text-gray-500 dark:text-stone-400 mx-6 mb-6">
      © 2026 ASCSV. Tutti i diritti riservati.
    </p>
  </aside>
</div>

<script src="../scripts/mobile-drawer.ts"></script>
<script type="module">
  ;(function () {
    function setHeaderHeight() {
      const header = document.querySelector('header[role="banner"]')
      if (!header) return
      const h = header.getBoundingClientRect().height
      document.documentElement.style.setProperty('--header-height', h + 'px')
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setHeaderHeight)
    } else {
      setHeaderHeight()
    }
    window.addEventListener('resize', setHeaderHeight)
    const headerEl = document.querySelector('header[role="banner"]')
    if (headerEl && typeof ResizeObserver !== 'undefined') {
      new ResizeObserver(setHeaderHeight).observe(headerEl)
    }
  })()
</script>
