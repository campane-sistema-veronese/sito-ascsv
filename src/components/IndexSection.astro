---
interface Props {
  id: string
  title: string
  tagLine?: string
  imageSrc: string
  imageAlt: string
  imagePosition?: 'left' | 'right'
}
const { id, title, tagLine, imageSrc, imageAlt, imagePosition = 'right' } = Astro.props
const textOrderClass = imagePosition === 'left' ? 'md:order-2' : 'md:order-1'
const imageOrderClass = imagePosition === 'left' ? 'md:order-1' : 'md:order-2'
---

<section id={id} class="max-w-4xl mx-auto p-8 grid md:grid-cols-2 gap-6 items-center">
  <div class={textOrderClass}>
    {tagLine && <p class="text-xs tracking-widest text-primary-600 dark:text-primary-300 uppercase mb-1">{tagLine}</p>}
    <h2 class="text-2xl font-semibold font-serif">{title}</h2>
    <p class="mt-8 leading-relaxed text-pretty">
      <slot />
    </p>
  </div>
  <div class={imageOrderClass}>
    <img src={imageSrc} alt={imageAlt} class="w-full rounded-lg object-cover h-64 md:h-112" />
  </div>
</section>
