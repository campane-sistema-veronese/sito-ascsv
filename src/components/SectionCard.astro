---
interface Props {
  title: string
  variant?: 'normal' | 'primary' | 'contrast'
  class?: string
}

const { title, variant = 'normal', class: className = '' } = Astro.props
const hasFooter = Astro.slots.has('footer')

const outerClasses = {
  normal: 'rounded-xl border border-stone-200 bg-white p-8 dark:border-stone-700 dark:bg-stone-800',
  primary: 'rounded-xl bg-primary-100 p-8 text-primary-900 dark:bg-primary-900/40 dark:text-primary-100',
  contrast: 'rounded-xl bg-stone-900 p-8 text-white',
}[variant]

const titleClasses = {
  normal: 'font-serif text-xl font-semibold',
  primary: 'font-serif text-xl font-semibold',
  contrast: 'font-serif text-xl font-semibold text-primary-300',
}[variant]

const bodyClasses = {
  normal: 'mt-3 text-sm leading-relaxed text-stone-600 dark:text-stone-300',
  primary: 'mt-3 text-sm leading-relaxed opacity-90',
  contrast: 'mt-3 text-sm leading-relaxed text-stone-300',
}[variant]
---

<div class:list={[outerClasses, 'h-full', hasFooter && 'flex flex-col justify-between gap-6', className]}>
  <div>
    <h3 class={titleClasses}>{title}</h3>
    <div class={bodyClasses}>
      <slot />
    </div>
  </div>
  {hasFooter && <slot name="footer" />}
</div>
