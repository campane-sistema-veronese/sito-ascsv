---
const {
  tagLine = 'Associazione Suonatori di Campane a Sistema Veronese',
  title = 'A.S.C.S.V.',
  subtitle = 'Antichi suoni, nuove emozioni: cultura e tradizione nel territorio',
  ctaText = 'Scopri di più',
  ctaHref = '#about',
  image = '/images/MinerbeInterno.jpg',
  imageAlt = 'Interno di Minerbe',
} = Astro.props
---

<section class="relative h-screen flex items-center justify-center" role="region" aria-label="Hero">
  <img src={image} alt={imageAlt} class="z-0 absolute inset-0 w-full h-full object-cover" />
  <div class="absolute z-5 inset-0 bg-black/50"></div>
  <div
    class="relative z-10 max-w-4xl mx-auto text-center text-white py-20 px-6 flex flex-col items-center justify-center gap-4"
  >
    <hgroup>
      <p class="text-primary-300 uppercase tracking-widest">{tagLine}</p>
      <h1 class="font-serif text-6xl md:text-8xl mt-8 font-bolder">{title}</h1>
    </hgroup>
    <p class="mt-4 font-serif">{subtitle}</p>
    <a
      href={ctaHref}
      class="bg-primary-500 mt-4 text-on-primary px-10 py-4 rounded-xl font-label-caps text-label-caps uppercase"
    >
      {ctaText}
    </a>
  </div>
</section>
