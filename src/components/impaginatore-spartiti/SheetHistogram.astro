---

---

<div id="bsp-stats-section" class="hidden mt-8">
  <h2 class="text-lg font-semibold text-stone-800 dark:text-stone-200 mb-4">Battute per campana</h2>
  <div id="bsp-histogram-container" class="flex justify-center max-w-xs mx-auto"></div>
</div>

<style is:global>
  :root {
    --bsp-bar-fill: var(--color-primary-600);
    --bsp-bar-stroke: var(--color-primary-800);
    --bsp-label-fill: #1c1917;
    --bsp-svg-bg: #f5f5f4;
  }
  .dark {
    --bsp-bar-fill: var(--color-primary-400);
    --bsp-bar-stroke: var(--color-primary-200);
    --bsp-label-fill: #f5f5f4;
    --bsp-svg-bg: #292524;
  }
  .bsp-histogram-bar {
    fill: var(--bsp-bar-fill);
    stroke: var(--bsp-bar-stroke);
    stroke-linejoin: round;
    stroke-linecap: round;
    stroke-width: 0.5px;
  }
  .bsp-histogram-label {
    fill: var(--bsp-label-fill);
    font-size: 0.75em;
  }
  .bsp-histogram-svg {
    padding: 1em 2em;
    border-radius: 0.75rem;
    overflow: hidden;
    background-color: var(--bsp-svg-bg);
  }
</style>

<script>
  const statsSection = document.getElementById('bsp-stats-section') as HTMLDivElement
  const container = document.getElementById('bsp-histogram-container') as HTMLDivElement

  function render(data: Record<string, number>) {
    container.innerHTML = ''
    const keys = Object.keys(data)
    if (keys.length === 0) return

    const barWidth = 10
    const spacing = 2
    const max = Math.max(...Object.values(data))
    const totalWidth = keys.length * barWidth + (keys.length - 1) * spacing

    const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg')
    svg.setAttribute('viewBox', `0 0 ${totalWidth} 120`)
    svg.setAttribute('width', '100%')
    svg.setAttribute('height', '10em')
    svg.classList.add('bsp-histogram-svg')

    keys.forEach((item, i) => {
      const count = data[item]
      const x = i * (barWidth + spacing)
      const barHeight = (count / max) * 100

      const rect = document.createElementNS('http://www.w3.org/2000/svg', 'rect')
      rect.setAttribute('x', String(x))
      rect.setAttribute('y', String(100 - barHeight))
      rect.setAttribute('width', String(barWidth))
      rect.setAttribute('height', String(barHeight))
      rect.classList.add('bsp-histogram-bar')

      const title = document.createElementNS('http://www.w3.org/2000/svg', 'title')
      title.textContent = `${count} battut${count === 1 ? 'a' : 'e'}`
      rect.appendChild(title)

      const text = document.createElementNS('http://www.w3.org/2000/svg', 'text')
      text.setAttribute('x', String(x + barWidth / 2))
      text.setAttribute('y', '115')
      text.setAttribute('dominant-baseline', 'middle')
      text.setAttribute('text-anchor', 'middle')
      text.classList.add('bsp-histogram-label')
      text.textContent = item

      svg.appendChild(rect)
      svg.appendChild(text)
    })

    container.appendChild(svg)
  }

  document.addEventListener('bsp-show-histogram', (e) => {
    render((e as CustomEvent<Record<string, number>>).detail)
    statsSection.classList.remove('hidden')
  })
</script>
