---
import Button from './Button.astro'
import SectionHeader from './SectionHeader.astro'
import UnescoLogo from './UnescoLogo.astro'
---

<section
  id="unesco"
  class="relative overflow-hidden bg-stone-50 py-16 md:py-24 dark:bg-stone-950"
  aria-labelledby="unesco-title"
>
  <div
    class="pointer-events-none absolute right-0 top-0 h-full w-1/3 -skew-x-12 translate-x-1/2 transform bg-primary-100/40 dark:bg-primary-900/10"
    aria-hidden="true"
  >
  </div>

  <div class="relative z-10 mx-auto max-w-4xl px-8">
    <div class="flex flex-col items-center gap-12 md:flex-row md:gap-16">
      <!-- Logo -->
      <div class="flex shrink-0 justify-center">
        <div
          class="flex h-52 w-52 items-center justify-center rounded-full border-4 border-primary-400 bg-white p-6 shadow-md dark:border-primary-600 dark:bg-stone-900"
        >
          <UnescoLogo class="h-full w-full text-stone-900 dark:text-stone-50" />
        </div>
      </div>

      <!-- Text -->
      <div>
        <SectionHeader title="Patrimonio dell'Umanità" tagLine="Patrimonio Culturale Immateriale" id="unesco-title" />

        <blockquote
          class="mt-6 border-l-4 border-primary-400 pl-5 font-serif text-base italic leading-relaxed text-stone-600 dark:border-primary-500 dark:text-stone-300"
        >
          "L'arte del suono delle campane manuale rappresenta un pilastro dell'identità culturale delle comunità locali,
          promuovendo la coesione sociale e il dialogo intergenerazionale attraverso una pratica artistica che unisce
          musica e architettura."
        </blockquote>

        <div
          class="mt-6 rounded-lg border border-stone-200 bg-white p-5 text-sm dark:border-stone-700 dark:bg-stone-900"
        >
          <p class="font-semibold text-stone-900 dark:text-stone-100">UNESCO — Dicembre 2024</p>
          <p class="mt-2 leading-relaxed text-stone-600 dark:text-stone-300">
            L'Arte del suono manuale delle campane è stata iscritta ufficialmente nella lista rappresentativa del
            patrimonio culturale immateriale dell'umanità. Questo è un riconoscimento anche all'eccellenza tecnica del
            Sistema Veronese e al costante impegno dell'Associazione nella trasmissione dei saperi alle giovani
            generazioni.
          </p>
        </div>

        <div class="mt-6">
          <Button
            title="Scopri la pratica su UNESCO"
            href="https://ich.unesco.org/en/RL/manual-bell-ringing-02100"
            target="_blank"
            rel="noopener noreferrer"
            icon="open_in_new"
            iconPosition="right"
            size="md"
          />
        </div>
      </div>
    </div>
  </div>
</section>
