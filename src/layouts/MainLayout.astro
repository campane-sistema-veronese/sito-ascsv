---
import Header from '../components/Header.astro'
import ThemeInit from '../components/ThemeInit.astro'
import { urlFor } from '../scripts/utils'
import '../styles/global.css'
---

<html lang="it" class="scroll-smooth">
  <head>
    <ThemeInit />
    <meta charset="utf-8" />
    <link rel="icon" href={urlFor('favicon.ico')} />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>ASCSV - Associazione Suonatori di Campane a Sistema Veronese</title>
  </head>
  <body class="antialiased bg-stone-50 text-stone-900 dark:bg-stone-950 dark:text-stone-100 transition-colors">
    <a
      href="#main"
      class="sr-only focus:absolute focus:top-4 focus:left-4 focus:bg-white focus:text-black focus:px-3 focus:py-2 dark:focus:bg-stone-900 dark:focus:text-stone-100"
      >Vai al contenuto</a
    >
    <Header
      items={[
        { label: 'Chi siamo', href: '/#about' },
        { label: 'Il metodo', href: '/#metodo' },
        { label: 'Archivio', href: '/archivio' },
      ]}
    />

    <main id="main">
      <slot />
    </main>
  </body>
</html>
