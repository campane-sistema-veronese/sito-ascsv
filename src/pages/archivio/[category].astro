---
import { getCollection } from 'astro:content'
import {
  ARCHIVE_CATEGORY_BY_SLUG,
  ARCHIVE_CATEGORY_META,
  ARCHIVE_CATEGORY_SLUGS,
} from '../../constants/archive-categories'
import MainLayout from '../../layouts/MainLayout.astro'
import '../../styles/global.css'

export const getStaticPaths = () =>
  ARCHIVE_CATEGORY_SLUGS.map((item) => ({
    params: { category: item.slug },
    props: { categoryLabel: item.label },
  }))

interface Props {
  categoryLabel: (typeof ARCHIVE_CATEGORY_SLUGS)[number]['label']
}

const { category: categorySlug } = Astro.params
const { categoryLabel } = Astro.props as Props

if (!categorySlug || !(categorySlug in ARCHIVE_CATEGORY_BY_SLUG)) {
  return Astro.redirect('/archivio')
}

const allDocuments = await getCollection('documents')
const documents = allDocuments
  .filter((doc) => doc.data.category === categoryLabel)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())

const categoriesWithCount = ARCHIVE_CATEGORY_META.map((item) => ({
  ...item,
  count: allDocuments.filter((doc) => doc.data.category === item.label).length,
})).filter((item) => item.count > 0)

const currentCategoryMeta = categoriesWithCount.find((item) => item.slug === categorySlug)

const formatDate = (date: Date) =>
  date.toLocaleDateString('it-IT', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  })
---

<MainLayout>
  <section class="mx-auto w-full max-w-7xl px-4 py-10 md:px-6 md:py-12">
    <a
      href="/archivio"
      class="inline-flex items-center gap-1 text-sm font-medium text-primary-700 hover:text-primary-800 dark:text-primary-300 dark:hover:text-primary-200"
    >
      <span class="material-symbols-outlined text-base">arrow_back</span>
      Torna alle categorie
    </a>

    <div class="mt-6 grid gap-8 lg:grid-cols-[17rem_minmax(0,1fr)] lg:gap-10">
      <aside class="hidden lg:block">
        <div
          class="sticky top-24 rounded-xl border border-stone-200 bg-white p-4 dark:border-stone-800 dark:bg-stone-900"
        >
          <p class="px-2 pb-3 text-xs uppercase tracking-[0.16em] text-stone-500 dark:text-stone-400">Categorie</p>
          <nav aria-label="Categorie archivio" class="space-y-1">
            {
              categoriesWithCount.map((item) => {
                const isActive = item.slug === categorySlug

                return (
                  <a
                    href={`/archivio/${item.slug}`}
                    aria-current={isActive ? 'page' : undefined}
                    class:list={[
                      'flex items-center justify-between rounded-lg px-3 py-2 text-sm transition-colors',
                      isActive
                        ? 'bg-primary-50 text-primary-900 dark:bg-primary-900/30 dark:text-primary-100'
                        : 'text-stone-700 hover:bg-stone-100 dark:text-stone-200 dark:hover:bg-stone-800',
                    ]}
                  >
                    <span class="inline-flex items-center gap-2">
                      <span class="material-symbols-outlined text-lg">{item.icon}</span>
                      {item.label}
                    </span>
                    <span class="text-xs text-stone-500 dark:text-stone-400">{item.count}</span>
                  </a>
                )
              })
            }
          </nav>
        </div>
      </aside>

      <div>
        <div class="overflow-x-auto archive-chip-scroll lg:hidden">
          <nav aria-label="Categorie archivio mobile" class="flex w-max gap-2 pb-1">
            {
              categoriesWithCount.map((item) => {
                const isActive = item.slug === categorySlug

                return (
                  <a
                    href={`/archivio/${item.slug}`}
                    aria-current={isActive ? 'page' : undefined}
                    class:list={[
                      'inline-flex items-center gap-1 rounded-full border px-3 py-2 text-xs font-medium uppercase tracking-wide transition-colors',
                      isActive
                        ? 'border-primary-400 bg-primary-100 text-primary-900 dark:border-primary-600 dark:bg-primary-900/40 dark:text-primary-100'
                        : 'border-stone-300 bg-white text-stone-700 dark:border-stone-700 dark:bg-stone-900 dark:text-stone-200',
                    ]}
                  >
                    <span class="material-symbols-outlined text-base">{item.icon}</span>
                    {item.label}
                  </a>
                )
              })
            }
          </nav>
        </div>

        <header
          class="mt-4 rounded-2xl border border-stone-200 bg-white p-5 md:p-7 dark:border-stone-800 dark:bg-stone-900"
        >
          <p class="text-xs uppercase tracking-[0.16em] text-primary-700 dark:text-primary-300">Categoria</p>
          <h1 class="mt-2 text-3xl font-serif md:text-4xl">{categoryLabel}</h1>
          <p class="mt-2 max-w-3xl text-sm text-stone-700 md:text-base dark:text-stone-200">
            {currentCategoryMeta?.description ?? 'Documenti disponibili in questa categoria.'}
          </p>
          <p class="mt-3 text-xs uppercase tracking-wide text-stone-500 dark:text-stone-400">
            {documents.length}
            {documents.length === 1 ? 'documento disponibile' : 'documenti disponibili'}
          </p>
        </header>

        <div class="mt-4 rounded-xl border border-stone-200 bg-white p-4 dark:border-stone-800 dark:bg-stone-900">
          <label for="archive-search" class="text-xs uppercase tracking-[0.16em] text-stone-500 dark:text-stone-400">
            Cerca nella categoria corrente
          </label>
          <div class="relative mt-2">
            <span
              class="material-symbols-outlined pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-stone-400"
            >
              search
            </span>
            <input
              id="archive-search"
              type="search"
              placeholder="Cerca per titolo o descrizione..."
              autocomplete="off"
              class="w-full rounded-lg border border-stone-300 bg-white py-2.5 pr-3 pl-10 text-sm text-stone-900 focus:border-primary-500 focus:outline-none dark:border-stone-700 dark:bg-stone-950 dark:text-stone-100"
            />
          </div>
        </div>

        {
          documents.length === 0 ? (
            <p class="mt-6 rounded-lg border border-stone-200 bg-white p-6 text-stone-700 dark:border-stone-800 dark:bg-stone-900 dark:text-stone-200">
              Nessun documento disponibile in questa categoria.
            </p>
          ) : (
            <ul id="archive-list" class="mt-6 space-y-4">
              {documents.map((doc) => (
                <li
                  class="archive-item rounded-xl border border-stone-200 bg-white p-5 dark:border-stone-800 dark:bg-stone-900"
                  data-search-index={`${doc.data.title} ${doc.data.description}`.toLowerCase()}
                >
                  <div class="flex items-start justify-between gap-4">
                    <div>
                      <h2 class="text-lg font-serif text-stone-900 dark:text-stone-100">{doc.data.title}</h2>
                      <p class="mt-1 text-xs uppercase tracking-wide text-stone-500 dark:text-stone-400">
                        {formatDate(doc.data.date)}
                      </p>
                    </div>
                    <span class="inline-flex items-center gap-1 rounded-full bg-stone-100 px-2 py-1 text-[11px] font-medium tracking-wide text-stone-600 dark:bg-stone-800 dark:text-stone-300">
                      <span class="material-symbols-outlined text-sm">picture_as_pdf</span>
                      PDF
                    </span>
                  </div>

                  <p class="mt-3 text-sm leading-relaxed text-stone-700 dark:text-stone-200">{doc.data.description}</p>
                  <a
                    href={doc.data.file}
                    download
                    class="mt-4 inline-flex items-center gap-1 rounded-md bg-primary-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-primary-700"
                    aria-label={`Scarica PDF: ${doc.data.title}`}
                  >
                    Scarica PDF
                    <span class="material-symbols-outlined text-base">download</span>
                  </a>
                </li>
              ))}
            </ul>
          )
        }

        <p
          id="archive-empty-search"
          class="mt-6 hidden rounded-lg border border-stone-200 bg-white p-5 text-sm text-stone-700 dark:border-stone-800 dark:bg-stone-900 dark:text-stone-200"
        >
          Nessun risultato per la ricerca in questa categoria.
        </p>
      </div>
    </div>
  </section>
</MainLayout>

<script>
  const searchInput = document.querySelector('#archive-search') as HTMLInputElement | null
  const list = document.querySelector('#archive-list')
  const items = Array.from(document.querySelectorAll<HTMLElement>('.archive-item'))
  const emptyMessage = document.querySelector('#archive-empty-search')

  if (searchInput && list && items.length > 0 && emptyMessage) {
    searchInput.addEventListener('input', () => {
      const query = searchInput.value.trim().toLowerCase()
      let visibleItems = 0

      items.forEach((item) => {
        const index = item.dataset.searchIndex ?? ''
        const isVisible = query.length === 0 || index.includes(query)

        item.classList.toggle('hidden', !isVisible)
        if (isVisible) visibleItems += 1
      })

      list.classList.toggle('hidden', visibleItems === 0)
      emptyMessage.classList.toggle('hidden', visibleItems > 0)
    })
  }
</script>
