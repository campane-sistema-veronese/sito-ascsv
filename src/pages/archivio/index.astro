---
import { archiveCategories, archiveCategorySlugs } from '@/constants/archive-categories'
import MainLayout from '@/layouts/MainLayout.astro'
import { fetchCategoriesWithCount } from '@/scripts/sanity-fetch'
import { urlFor } from '@/scripts/utils'
import '@/styles/global.css'

const allegati = await fetchCategoriesWithCount()
const categoryCards = archiveCategorySlugs
  .map((item) => {
    const count = allegati.filter((doc) => doc.category === item).length
    return {
      ...archiveCategories[item],
      count,
    }
  })
  .filter((item) => item.count > 0)
---

<MainLayout>
  <section class="mx-auto w-full max-w-6xl px-4 py-10 md:px-6 md:py-14">
    <div
      class="rounded-2xl border border-stone-200 bg-linear-to-r from-primary-50 via-stone-50 to-white p-6 md:p-8 dark:border-stone-800 dark:from-primary-950/30 dark:via-stone-950 dark:to-stone-900"
    >
      <p class="text-xs uppercase tracking-[0.18em] text-primary-700 dark:text-primary-300">Archivio ASCSV</p>
      <h1 class="mt-3 text-3xl font-serif md:text-5xl">Scegli una categoria</h1>
      <p class="mt-3 max-w-3xl text-sm text-stone-700 md:text-base dark:text-stone-200">
        Questa sezione raccoglie i documenti ufficiali dell'associazione. Entra nella categoria che ti interessa per
        consultare e scaricare i PDF disponibili.
      </p>
    </div>

    {
      categoryCards.length === 0 ? (
        <p class="mt-8 rounded-lg border border-stone-200 bg-white p-6 text-stone-700 dark:border-stone-800 dark:bg-stone-900 dark:text-stone-200">
          Nessun documento disponibile.
        </p>
      ) : (
        <ul class="mt-8 grid gap-4 md:grid-cols-2 xl:grid-cols-3" data-ssr-mode="true">
          {categoryCards.map((item) => (
            <li data-category-slug={item.slug}>
              <a
                href={urlFor(`/archivio/${item.slug}`)}
                class="group block h-full rounded-xl border border-stone-200 bg-white p-5 transition-all hover:-translate-y-0.5 hover:border-primary-300 hover:shadow-sm dark:border-stone-800 dark:bg-stone-900 dark:hover:border-primary-800"
              >
                <div class="flex items-center justify-between gap-3">
                  <span class="material-symbols-outlined text-2xl text-primary-600 dark:text-primary-300">
                    {item.icon}
                  </span>
                  <span data-count-display class="text-xs uppercase tracking-wide text-stone-500 dark:text-stone-400">
                    {item.count} {item.count === 1 ? 'documento' : 'documenti'}
                  </span>
                </div>

                <p class="mt-4 text-xl font-serif text-stone-900 dark:text-stone-100">{item.label}</p>
                <p class="mt-2 text-sm leading-relaxed text-stone-600 dark:text-stone-300">{item.description}</p>

                <p class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-primary-700 group-hover:text-primary-800 dark:text-primary-300 dark:group-hover:text-primary-200">
                  Apri categoria
                  <span class="material-symbols-outlined text-lg">arrow_forward</span>
                </p>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</MainLayout>

<script>
  import { fetchCategoriesWithCount } from '@/scripts/sanity-fetch'

  /**
   * Fetch categories with count and update UI
   */
  async function loadCategoryCounts() {
    try {
      const categoriesWithCount = await fetchCategoriesWithCount()

      // Create a map for quick lookup
      const countMap = new Map(categoriesWithCount.map((item) => [item.category, item.count]))

      // Update count displays
      const cards = document.querySelectorAll<HTMLElement>('li[data-category-slug]')
      cards.forEach((card) => {
        const slug = card.dataset.categorySlug
        if (!slug) return

        const count = countMap.get(slug)
        if (count !== undefined) {
          const countDisplay = card.querySelector('[data-count-display]')
          if (countDisplay) {
            countDisplay.textContent = `${count} ${count === 1 ? 'documento' : 'documenti'}`
          }
        }
      })

      // Remove SSR mode indicator
      const container = document.querySelector('ul[data-ssr-mode]')
      if (container) {
        container.removeAttribute('data-ssr-mode')
      }
    } catch (error) {
      console.error('Failed to fetch category counts:', error)

      // Show warning banner
      const header = document.querySelector('header.rounded-2xl')
      if (header && !document.querySelector('#archive-category-fetch-warning')) {
        const warning = document.createElement('div')
        warning.id = 'archive-category-fetch-warning'
        warning.className =
          'mt-4 p-4 rounded-lg bg-yellow-50 border border-yellow-200 text-yellow-800 dark:bg-yellow-950/20 dark:border-yellow-900 dark:text-yellow-200 text-sm'
        warning.textContent =
          "Impossibile aggiornare i conteggi dal server. Visualizzando l'ultima versione disponibile."
        header.insertAdjacentElement('afterend', warning)
      }
    }
  }

  // Load category counts when page is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', loadCategoryCounts)
  } else {
    loadCategoryCounts()
  }
</script>
