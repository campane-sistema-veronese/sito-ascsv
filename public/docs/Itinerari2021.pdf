   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Wallpaper pattern of antique verdigris bronze with a patina. This is the background from an interlaced pattern.</rdf:li>
    </rdf:Alt>
   </dc:description>
